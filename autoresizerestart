#!/bin/bash

set -u

SCRIPT="/home/niko/projects/autoresize/autoresize_daemon.py"
LOG="/home/niko/projects/autoresize/daemon.log"

echo "Arrêt des anciens démons..."

# Arrêter uniquement les processus Python qui exécutent ce script précis.
pids=$(pgrep -f "^python3 $SCRIPT$" || true)

if [ -n "$pids" ]; then
    # Forcer l'arrêt immédiat (le daemon ne gère pas SIGTERM)
    while read -r pid; do
        [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
    done <<< "$pids"

    # Attendre leur arrêt
    for i in {1..15}; do
        pgrep -f "^python3 $SCRIPT$" >/dev/null || break
        sleep 1
    done
fi

echo "Démarrage du démon..."

cd /home/niko/projects/autoresize || exit 1
nohup python3 "$SCRIPT" >> "$LOG" 2>&1 &

sleep 1

pgrep -af "^python3 $SCRIPT$"
